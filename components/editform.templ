package components

import (
	"github.com/audunhov/tombolig/models"
	"fmt"
)

templ EditDialog(house *models.House) {
	{{
			dialogClasses := "border-none rounded-3xl shadow-2xl p-0 w-[95%] sm:w-[90%] max-w-md overflow-hidden backdrop:backdrop-blur-md"
			headerClasses := "flex justify-between items-center px-6 sm:px-10 py-4 sm:py-6 bg-gray-50 border-b border-gray-100"
			inputClasses := "w-full px-4 py-3 bg-white border border-gray-200 rounded-2xl focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all placeholder:text-gray-400 text-sm"
			labelClasses := "block text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-2 leading-none ml-1"
			
			title := "Rapporter"
			idVal := "0"
			addressVal := ""
			latVal := ""
			lngVal := ""
			descriptionVal := ""
			ownershipTypeVal := "privat-bolig"
			ownershipFreetextVal := ""
			knrVal := ""
			gnrVal := ""
			bnrVal := ""
			fnrVal := ""
			snrVal := ""

			if house != nil {
				title = "Rediger"
				idVal = fmt.Sprintf("%d", house.ID)
				addressVal = house.Address
				latVal = fmt.Sprintf("%f", house.Latitude)
				lngVal = fmt.Sprintf("%f", house.Longitude)
				descriptionVal = house.Description
				
				standardTypes := []string{"privat-bolig", "privat-bygård", "offentlig", "næring", "industri", "gård", "annet"}
				isStandard := false
				for _, t := range standardTypes {
					if t == house.OwnershipType {
						isStandard = true
						break
					}
				}

				if isStandard {
					ownershipTypeVal = house.OwnershipType
				} else {
					ownershipTypeVal = "freetext"
					ownershipFreetextVal = house.OwnershipType
				}

				knrVal = house.KommuneNr
				gnrVal = fmt.Sprintf("%d", house.GardsNr)
				bnrVal = fmt.Sprintf("%d", house.BruksNr)
				fnrVal = fmt.Sprintf("%d", house.FesteNr)
				snrVal = fmt.Sprintf("%d", house.SeksjonsNr)
			}
		}}

		<dialog id="editDialog" class={ dialogClasses }>
			<div class={ headerClasses }>
				<h2 id="dialog_title" class="text-xl sm:text-2xl font-black text-gray-900 tracking-tight">{ title }</h2>
				<form method="dialog" class="m-0 p-0 flex items-center">
					<button class="text-gray-300 hover:text-gray-900 text-3xl leading-none">&times;</button>
				</form>
			</div>
			<form id="editForm" action="/houses/update" method="POST" class="max-h-[75vh] overflow-y-auto p-6 sm:p-10 space-y-4 sm:space-y-6 bg-white">
				<input type="hidden" id="edit_id" name="id" value={ idVal }/>
				
				<div>
					<label class={ labelClasses }>Adresse</label>
					<input type="text" id="edit_address" name="address" required 
						class={ inputClasses } placeholder="f.eks. Storgata 10, Oslo" 
						value={ addressVal }
						hx-get="/api/address/lookup"
						hx-trigger="keyup changed delay:500ms"
						hx-target="#lookup_results"
						hx-on::before-request="if(this.value === '') { document.getElementById('lookup_results').classList.add('hidden'); return false; }"
						hx-on::after-request="document.getElementById('lookup_results').classList.remove('hidden')"/>
					<div id="lookup_status" class="text-[10px] mt-2 font-black uppercase text-gray-400"></div>
					<div id="restore_notice" class="mt-3 p-3 bg-blue-50 border border-blue-100 rounded-xl hidden">
						<div class="flex gap-2">
							<svg class="size-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
							<p class="text-[10px] font-bold text-blue-800 leading-tight">Denne boligen har vært rapportert tidligere. Ved å sende inn skjemaet vil du gjenåpne og oppdatere den eksisterende oppføringen.</p>
						</div>
					</div>
					<div id="lookup_results" class="border border-gray-100 rounded-2xl mt-3 hidden bg-white shadow-xl overflow-hidden divide-y divide-gray-50"></div>
				</div>

				<input type="hidden" id="edit_lat" name="lat" value={ latVal }/>
				<input type="hidden" id="edit_lng" name="lng" value={ lngVal }/>
				<input type="hidden" id="edit_knr" name="knr" value={ knrVal }/>
				<input type="hidden" id="edit_gnr" name="gnr" value={ gnrVal }/>
				<input type="hidden" id="edit_bnr" name="bnr" value={ bnrVal }/>
				<input type="hidden" id="edit_fnr" name="fnr" value={ fnrVal }/>
				<input type="hidden" id="edit_snr" name="snr" value={ snrVal }/>

				<div>
					<label class={ labelClasses }>Kategori / Eieform</label>
					<select id="edit_ownership_type" name="ownership_type" onchange="toggleFreetext(this.value)" class={ inputClasses + " appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22m6%208%204%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem_1.25rem] bg-[right_1rem_center] bg-no-repeat pr-10" }>
						<option value="privat-bolig" selected={ ownershipTypeVal == "privat-bolig" }>Privat bolig</option>
						<option value="privat-bygård" selected={ ownershipTypeVal == "privat-bygård" }>Privat bygård/blokk</option>
						<option value="offentlig" selected={ ownershipTypeVal == "offentlig" }>Offentlig bygg</option>
						<option value="næring" selected={ ownershipTypeVal == "næring" }>Næring/Butikk</option>
						<option value="industri" selected={ ownershipTypeVal == "industri" }>Industri/Lager</option>
						<option value="gård" selected={ ownershipTypeVal == "gård" }>Gård/Småbruk</option>
						<option value="annet" selected={ ownershipTypeVal == "annet" }>Vet ikke</option>
						<option value="freetext" selected={ ownershipTypeVal == "freetext" }>Annet...</option>
					</select>
				</div>

				<div id="edit_freetext_group" class={ templ.KV("hidden", ownershipTypeVal != "freetext") }>
					<label class={ labelClasses }>Beskriv kategori</label>
					<input type="text" id="edit_ownership_freetext" name="ownership_freetext" class={ inputClasses } value={ ownershipFreetextVal }/>
				</div>

				<div>
					<label class={ labelClasses }>Beskrivelse</label>
					<textarea id="edit_description" name="description" required class={ inputClasses + " h-24 sm:h-32 resize-none" } placeholder="Hvorfor tror du boligen er tom?">{ descriptionVal }</textarea>
				</div>

				<div class="flex gap-3 sm:gap-4 pt-2 sm:pt-4">
					<button formmethod="dialog" class="flex-1 py-3 text-gray-400 font-bold sm:text-lg">Avbryt</button>
					<button type="submit" class="flex-1 py-3 bg-blue-600 hover:bg-blue-700 text-white font-black uppercase tracking-widest text-[10px] sm:text-xs rounded-2xl shadow-xl shadow-blue-100 transition-all">Lagre</button>
				</div>
			</form>
		</dialog>
}
