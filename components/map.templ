package components

templ Map(username string) {
	@Layout("Boligaksjonen - Kontrollpanel", username) {
		<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
		<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.css"/>
		<link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.4.1/dist/MarkerCluster.Default.css"/>
		<script src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1" type="module"></script>
		<style>
			#map { height: 100%; width: 100%; z-index: 1; }
			.leaflet-container { font-family: inherit; height: 100% !important; width: 100% !important; }
			dialog::backdrop { background: rgba(0,0,0,0.5); backdrop-filter: blur(2px); }
			.lookup-item:hover { background: #f8fafc; }

			/* Leaflet Popup Refinements */
			.leaflet-popup-content-wrapper { border-radius: 1rem; padding: 0; overflow: hidden; }
			.leaflet-popup-content { margin: 0; width: auto !important; }
			.leaflet-popup-tip-container { display: none; }

			/* Custom Cluster Colors */
			.marker-cluster-small { background-color: rgba(37, 99, 235, 0.6); }
			.marker-cluster-small div { background-color: rgba(37, 99, 235, 0.6); color: white; font-weight: bold; }
			.marker-cluster-medium { background-color: rgba(29, 78, 216, 0.6); }
			.marker-cluster-medium div { background-color: rgba(29, 78, 216, 0.6); color: white; font-weight: bold; }
			.marker-cluster-large { background-color: rgba(30, 58, 138, 0.6); }
			.marker-cluster-large div { background-color: rgba(30, 58, 138, 0.6); color: white; font-weight: bold; }
			
			/* Floating Topbar Animation (Desktop Only) */
			@media (min-width: 768px) {
				#floating-header {
					transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
					transform: translateY(-10px);
					opacity: 0.9;
				}
				#floating-header:hover {
					transform: translateY(0);
					opacity: 1;
					box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
				}
			}

			/* Mobile/Medium Bottom Sheet Styles */
			@media (max-width: 1023px) {
				#detail_aside {
					width: 100% !important;
					height: 70vh !important;
					position: fixed !important;
					bottom: 0 !important;
					left: 0 !important;
					right: 0 !important;
					top: auto !important;
					border-left: none !important;
					border-top: 1px solid #e5e7eb !important;
					border-radius: 2.5rem 2.5rem 0 0 !important;
					transform: translateY(100%) !important;
					z-index: 2000 !important;
					display: block !important;
				}
				#detail_aside.is-open {
					transform: translateY(0) !important;
				}
				.sheet-handle {
					width: 40px;
					height: 4px;
					background: #e5e7eb;
					border-radius: 2px;
					margin: 12px auto;
				}
			}
		</style>
		<div class="flex h-full min-h-0 overflow-hidden relative">
			<main class="flex-1 relative min-h-0">
				<div id="map" class="h-full w-full"></div>

				<!-- Floating Header -->
				<div class="absolute top-4 left-0 right-0 z-[1000] px-2 sm:px-4 pointer-events-none">
					<header id="floating-header" class="mx-auto max-w-5xl bg-white/95 backdrop-blur-md border border-gray-200 rounded-2xl shadow-lg flex h-14 sm:h-16 shrink-0 items-center gap-x-2 sm:gap-x-4 px-2 sm:px-6 pointer-events-auto">
						<!-- Icon Link -->
						<a href="/" class="flex h-9 w-9 sm:h-10 sm:w-10 shrink-0 shadow-md shadow-blue-200 hover:scale-105 transition-all active:scale-95" title="Gå til forsiden">
							<img src="/static/img/logo.svg" alt="Boligaksjonen Logo" class="h-full w-full rounded-xl"/>
						</a>

						<div class="flex flex-1 gap-x-2 sm:gap-x-4 self-stretch items-center min-w-0">
							<!-- Search -->
							<div class="flex-1 relative min-w-0">
								<svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 size-4 text-gray-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd"/></svg>
								<input type="search" name="q" placeholder="Søk..." 
									class="block w-full rounded-xl border-0 py-1.5 pl-9 pr-3 text-gray-900 ring-1 ring-inset ring-gray-200 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-blue-600 text-xs sm:text-sm bg-gray-50/50" 
									hx-get="/api/address/lookup?header=true"
									hx-trigger="keyup changed delay:500ms"
									hx-target="#header_lookup_results"
									hx-on::before-request="if(this.value === '') { document.getElementById('header_lookup_results').classList.add('hidden'); return false; }"
									hx-on::after-request="document.getElementById('header_lookup_results').classList.remove('hidden')"/>
								<div id="header_lookup_results" class="absolute top-full mt-2 left-0 w-[280px] sm:w-full bg-white rounded-xl shadow-2xl border border-gray-100 hidden z-[1001] max-h-[60vh] overflow-y-auto overflow-x-hidden"></div>
							</div>

							<!-- Action Buttons -->
							<div class="flex items-center gap-x-1 sm:gap-x-2 shrink-0">
								<a href="/kart/historikk" class="p-2 text-gray-500 hover:text-blue-600 rounded-lg hover:bg-blue-50 transition-all" title="Historikk">
									<svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
								</a>

								<button type="button" 
									class="hidden sm:block px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-[10px] font-black uppercase tracking-wider rounded-xl shadow-lg shadow-blue-100 transition-all whitespace-nowrap" 
									hx-get="/houses/edit?id=0"
									hx-target="#edit_dialog_container"
									hx-swap="innerHTML"
									hx-on::after-request="document.getElementById('editDialog').showModal()">
									Rapporter
								</button>

								<div class="h-6 w-px bg-gray-200 mx-1"></div>

								<!-- User Dropdown -->
															if username != "" {
																<details class="relative">
        <summary class="list-none cursor-pointer p-1 rounded-full hover:bg-gray-50 transition-all focus:outline-none">
            <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-xs uppercase">{ username[0:1]
     }</div>
        </summary>
        <div class="absolute right-0 top-full mt-2 w-48 rounded-xl bg-white p-1 shadow-2xl ring-1 ring-black/5 z-[1002]">
            <a href="/logout" class="block px-3 py-2 text-sm font-medium text-red-600 rounded-lg hover:bg-red-50">Logg ut</a>
        </div>
    </details>

																} else {
									<div class="flex items-center gap-1">
										<button class="bg-gray-900 text-white p-2 sm:px-4 sm:py-2 rounded-xl hover:bg-gray-800 transition-all shadow-lg shadow-gray-200" onclick="document.getElementById('loginDialog').showModal()">
											<svg class="size-4 sm:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25V9m12 8.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 01-1.125-1.125V17.25M21 12.75a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0zm-15 0a1.875 1.875 0 11-3.75 0 1.875 1.875 0 013.75 0z" /></svg>
											<span class="hidden sm:inline text-[10px] font-black uppercase tracking-widest px-1">Logg inn</span>
										</button>
									</div>
								}
							</div>
						</div>
					</header>
				</div>
			</main>

			<!-- Detail Sidebar -->
			<aside id="detail_aside" class="w-96 border-l border-gray-200 bg-white overflow-y-auto hidden lg:block transition-all duration-300 translate-x-full absolute right-0 top-0 bottom-0 z-20 lg:relative lg:translate-x-0">
				<div class="lg:hidden sheet-handle"></div>
				<button class="lg:hidden absolute right-6 top-4 text-gray-400 text-2xl" onclick="window.closeAside()">&times;</button>
				
				<div class="p-6 sm:p-8">
					<div id="aside_placeholder" class="text-center py-20">
						<div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-4 text-gray-300 border border-gray-100 shadow-sm">
							<svg class="size-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
						</div>
						<h3 class="font-bold text-gray-900 tracking-tight">Ingen bolig valgt</h3>
						<p class="text-xs text-gray-400 mt-1">Dobbeltklikk i kartet for å rapportere en ny bolig.</p>
					</div>
					<div id="aside_content_wrapper"></div>
				</div>
			</aside>
		</div>

		<!-- Modals -->
		<div id="edit_dialog_container"></div>

		@AuthDialogs()

		<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
		<script src="https://unpkg.com/leaflet.markercluster@1.4.1/dist/leaflet.markercluster.js"></script>
		<script src="/static/js/auth.js"></script>
		<script src="/static/js/map.js"></script>
	}
}
