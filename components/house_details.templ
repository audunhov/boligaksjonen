package components

import (
	"github.com/audunhov/tombolig/models"
	"fmt"
	"strings"
)

func getOwnershipColor(ownershipType string) string {
	t := strings.ToLower(strings.TrimSpace(ownershipType))
	if t == "" {
		t = "annet"
	}
	switch t {
	case "privat-bolig":
		return "bg-green-100 text-green-700"
	case "privat-bygård":
		return "bg-green-100 text-green-700"
	case "offentlig":
		return "bg-blue-100 text-blue-700"
	case "næring":
		return "bg-yellow-100 text-yellow-800"
	case "industri":
		return "bg-gray-100 text-gray-700"
	case "gård":
		return "bg-orange-100 text-orange-800"
	case "annet":
		return "bg-gray-100 text-gray-500"
	default:
		return "bg-gray-100 text-gray-500"
	}
}

func getOwnershipLabel(ownershipType string) string {
	t := strings.ToLower(strings.TrimSpace(ownershipType))
	if t == "" {
		t = "annet"
	}
	return strings.ReplaceAll(t, "-", " ")
}

templ HouseDetails(house models.House, logs []models.AuditLog, username string) {
	<div id="aside_badge" class="mb-4">
		<span class={ "px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-widest", getOwnershipColor(house.OwnershipType) }>
			{ getOwnershipLabel(house.OwnershipType) }
		</span>
	</div>
	<h2 id="aside_address" class="text-2xl font-black text-gray-900 leading-tight mb-4 tracking-tight break-words">{ house.Address }</h2>
	<div id="aside_description" class="text-sm text-gray-600 mb-8 leading-relaxed break-words whitespace-pre-line">{ house.Description }</div>
	
	<div class="space-y-4 border-t border-gray-100 pt-6">
		<div class="flex items-center gap-3 text-sm">
			<div class="w-8 h-8 rounded-lg bg-gray-50 border border-gray-100 flex items-center justify-center text-gray-400">
				<svg class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
			</div>
			<div>
				<p class="text-gray-400 font-bold uppercase text-[9px] tracking-widest leading-none mb-1">Sist endret</p>
				<p id="aside_date" class="font-bold text-gray-900 text-xs">{ house.UpdatedAt.Format("02.01.2006 15:04:05") }</p>
			</div>
		</div>
	</div>

	<div class="mt-8 flex flex-col gap-2">
		<button id="aside_edit_btn" 
			class="w-full py-3 bg-gray-900 text-white text-xs font-black uppercase tracking-wider rounded-xl shadow-lg hover:bg-gray-800 transition-all flex items-center justify-center gap-2"
			hx-get={ string(templ.URL(fmt.Sprintf("/houses/edit?id=%d", house.ID))) }
			hx-target="#edit_dialog_container"
			hx-swap="innerHTML"
			hx-on::after-request="document.getElementById('editDialog').showModal()">
			<svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0 1 15.75 21H5.25A2.25 2.25 0 0 1 3 18.75V8.25A2.25 2.25 0 0 1 5.25 6H10"/></svg>
			Rediger
		</button>
		<form id="removeForm" action="/houses/remove" method="POST" onsubmit="return confirm('Er du sikker på at du vil fjerne denne boligen?')">
			<input type="hidden" name="id" id="remove_house_id" value={ fmt.Sprintf("%d", house.ID) }/>
			<button type="submit" class="w-full py-2.5 text-red-500 text-[10px] font-black uppercase tracking-widest hover:bg-red-50 rounded-xl transition-all flex items-center justify-center gap-2">
				Fjern oppføring
			</button>
		</form>
	</div>

	<!-- Advanced History & Comments -->
	<div class="mt-10 border-t border-gray-100 pt-8">
		<h3 class="text-[10px] font-black text-gray-400 uppercase tracking-[0.2em] mb-6 leading-none">Historikk</h3>
		<div id="aside_history_list">
			@AuditLogList(logs)
		</div>

		<div id="comment_section" class="mt-10 pt-8 border-t border-gray-100">
			<div class="flex gap-x-3">
				<div class="size-6 flex-none rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center font-bold text-[10px] uppercase shadow-sm border border-white">
					if username != "" {
						{ username[0:1] }
					} else {
						A
					}
				</div>
				<form id="commentForm" class="relative flex-auto" 
					hx-post="/api/houses/comment" 
					hx-target="#aside_history_list" 
					hx-on::after-request="this.reset()">
					<input type="hidden" name="house_id" id="comment_house_id" value={ fmt.Sprintf("%d", house.ID) }/>
					<div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-50/50 focus-within:ring-4 focus-within:ring-blue-500/10 focus-within:border-blue-500 transition-all">
						<textarea id="comment_text" name="comment" rows="2" placeholder="Skriv en kommentar..." class="block w-full resize-none bg-transparent px-3 py-2 text-xs text-gray-900 placeholder:text-gray-400 focus:outline-none"></textarea>
						<div class="flex justify-end p-2">
							<button type="submit" class="rounded-lg bg-blue-600 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-white shadow-md shadow-blue-100 hover:bg-blue-700 transition-all">Publiser</button>
						</div>
					</div>
				</form>
			</div>
		</div>
	</div>
}
